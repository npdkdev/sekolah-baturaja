PORT=8080
DATABASE_URL=postgresql://postgres:password@localhost:5432/lpq_db

# Generate dengan: openssl rand -hex 32
# Wajib minimal 32 karakter dan keduanya HARUS berbeda — server menolak start
# kalau tidak. Secret yang sama membuat refresh token bisa dipakai sebagai
# access token.
JWT_SECRET=ganti_dengan_secret_panjang_random
JWT_REFRESH_SECRET=ganti_dengan_secret_refresh_berbeda

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=20

# Origin frontend (untuk CORS). WAJIB diisi — tidak ada lagi fallback "*".
# Origin yang tidak terdaftar tidak menerima header CORS sama sekali.
# Boleh beberapa, dipisah koma: https://app.contoh.id,https://staging.contoh.id
CORS_ORIGIN=http://localhost:3000

# Set "true" HANYA kalau backend berada di belakang reverse proxy (nginx,
# Caddy, Cloudflare) yang menulis ulang X-Forwarded-For. Kalau backend bisa
# dijangkau langsung, biarkan kosong: header itu bisa dipalsukan siapa saja dan
# akan melumpuhkan rate limit login.
TRUST_PROXY=false
